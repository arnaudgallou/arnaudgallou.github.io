```{=html}
<div class="list grid quarto-listing-cols-3">
  <% for (const item of items) { %>
    <div class="quarto-grid-item card h-100 card-left">
      <div class="card-body post-contents">
        <div class="card-body-wrapper">
          <h5 class="no-anchor card-title listing-title"><%= item.title %></h5>
          <% if (item.categories && item.categories.length) { %>
            <div class="listing-categories">
              <% item.categories.forEach(category => { %>
                <span class="listing-category"><%= category %></span>
              <% }) %>
            </div>
          <% } %>
          <div class="card-text listing-description delink">
            <p><%= item.description %></p>
          </div>
        </div>
        <div class="card-footer-extra">
          <% const links = {github: "github", site: "file-text-fill"} %>
          <% Object.entries(links).forEach(([id, icon]) => { %>
            <% if (item[id]) { %>
              <a href="<%- item[id] %>" target="_blank" rel="noopener">
                <i class="bi bi-<%= icon %>"></i>
              </a>
            <% } %>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>
</div>
```
