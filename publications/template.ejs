```{=html}
<div class="pub">
  <% for (const item of items) { %>
    <div class="pub-item">
      <h4><%= item.title %></h4>
      <p class="pub-authors"><%= item.authors %></p>
      <div class="pub-meta">
        <span class="pub-meta-journal"><%= item.journal %></span>
        <span class="pub-meta-date"><%= item.date %></span>
          <% if (item.links) { %>
            <% Object.entries(item.links).forEach(([key, value]) => { %>
              <a href="<%- value %>" class="pub-meta-link link-btn" target="_blank" rel="noopener">
                <%= key.toUpperCase() %>
              </a>
            <% }) %>
          <% } %>
      </div>
    </div>
  <% } %>
</div>
```
